APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

# Ingestion: requests per minute per key, and max Horizon processes for the ingest queue
# FAULT_INGEST_RATE_LIMIT=300
# FAULT_INGEST_MAX_PROCESSES=30
# FAULT_INGEST_EVENTS_RATE_LIMIT=1000
# FAULT_MAX_BODY_BYTES=1048576
# FAULT_MAX_DECOMPRESSED_BYTES=10485760
# FAULT_MAX_ENVELOPE_ITEMS=100
# FAULT_ALERT_COOLDOWN_SECONDS=60

# Monitors refuse private/loopback targets unless this is true (LAN self-hosting)
# MONITORING_ALLOW_PRIVATE_TARGETS=false

# Data lifecycle (days)
# MONITORING_COMPACT_AFTER_DAYS=7
# MONITORING_RETENTION_DAYS=365

# Octane
# OCTANE_SERVER=roadrunner
# OCTANE_HTTPS=false

# Horizon
# HORIZON_NAME=
# HORIZON_DOMAIN=
# HORIZON_PATH=horizon

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_USERNAME=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

HORIZON_ALLOWED_EMAILS="you@example.com"

REGISTRATION_ENABLED=true

GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_SLUG=

SLACK_APP_CLIENT_ID=
SLACK_APP_CLIENT_SECRET=
SLACK_APP_SIGNING_SECRET=
SLACK_APP_SCOPES="chat:write,channels:read,groups:read"

# SLACK_BOT_USER_OAUTH_TOKEN=
# SLACK_BOT_USER_DEFAULT_CHANNEL=
# POSTMARK_API_KEY=
# RESEND_API_KEY=

FAULT_MAX_ATTACHMENT_BYTES=1048576
FAULT_MAX_ATTACHMENTS_PER_EVENT=5
FAULT_MAX_CRON_MONITORS=100
FAULT_CRON_CHECK_IN_RETENTION_DAYS=30
FAULT_AI_TRIAGE_MODEL=~typesafe/jev-latest
FAULT_AI_TRIAGE_HOURLY_LIMIT=60

FAULT_MAX_SOURCE_MAP_BYTES=20971520
FAULT_MAX_SOURCE_MAPS_PER_RELEASE=500
FAULT_SYMBOLICATION_MAX_FRAMES=100
